<UserControl x:Class="SecretFix.Views.FlickTrainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,42,0"><TextBlock Text="TRACKING" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="PointsText" Text="0 pontos" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Margin="0,0,42,0"><TextBlock Text="TIME" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="TimeText" Text="60.0s" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                <StackPanel><TextBlock Text="ACCURACY" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="AccuracyText" Text="0%" FontSize="20" FontWeight="SemiBold"/></StackPanel>
            </StackPanel>
            <TextBlock x:Name="LockText" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,20,0,16" ClipToBounds="True">
            <Canvas x:Name="TrainingCanvas" Background="#D9050507" MouseDown="TrainingCanvas_MouseDown">
                <Ellipse x:Name="Target" Width="34" Height="34" Fill="{StaticResource AccentBrush}" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="2" Canvas.Left="240" Canvas.Top="160" MouseDown="Target_MouseDown"/>
            </Canvas>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="START" Style="{StaticResource PrimaryButtonStyle}" Click="Start_Click" Margin="0,0,8,0"/>
            <Button Content="STOP" Style="{StaticResource SecondaryButtonStyle}" Click="Stop_Click" Margin="0,0,8,0"/>
            <Button Content="RESET" Style="{StaticResource SecondaryButtonStyle}" Click="Reset_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
