<UserControl x:Class="SecretFix.Views.AimView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="Mira" Style="{StaticResource H1TextStyle}"/>
            <TextBlock Text="Preview desktop legítimo, sem injeção no FiveM" Style="{StaticResource CaptionTextStyle}" Margin="0,7,0,22"/>
            <UniformGrid Columns="4" Margin="0,0,0,18">
                <Button Content="BASIC" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Preset_Click"/>
                <Button Content="MEDIUM" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Preset_Click"/>
                <Button Content="HIGH" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Preset_Click"/>
                <Button Content="CUSTOM" Style="{StaticResource PrimaryButtonStyle}" Click="Preset_Click"/>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Button Content="ATIVAR MIRA" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="Activate_Click"/>
                <Button Content="DESATIVAR MIRA" Style="{StaticResource SecondaryButtonStyle}" Click="Deactivate_Click"/>
            </StackPanel>
            <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="CONTROLES" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <TextBlock Text="Size" Foreground="{StaticResource MutedBrush}"/><Slider x:Name="SizeSlider" Style="{StaticResource ThinSliderStyle}" Minimum="8" Maximum="80" Value="34" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Text="Thickness" Foreground="{StaticResource MutedBrush}"/><Slider x:Name="ThicknessSlider" Style="{StaticResource ThinSliderStyle}" Minimum="1" Maximum="8" Value="2" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Text="Gap" Foreground="{StaticResource MutedBrush}"/><Slider x:Name="GapSlider" Style="{StaticResource ThinSliderStyle}" Minimum="0" Maximum="30" Value="8" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Text="Opacity" Foreground="{StaticResource MutedBrush}"/><Slider x:Name="OpacitySlider" Style="{StaticResource ThinSliderStyle}" Minimum="20" Maximum="100" Value="90" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Text="Color" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,4"/>
                    <ComboBox x:Name="ColorBox" SelectedIndex="0" SelectionChanged="ColorBox_SelectionChanged">
                        <ComboBoxItem Content="Red"/>
                        <ComboBoxItem Content="White"/>
                    </ComboBox>
                    <TextBlock Text="Smoothness" Foreground="{StaticResource MutedBrush}"/><Slider Style="{StaticResource ThinSliderStyle}" Minimum="0" Maximum="100" Value="45"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18" Margin="24,0,0,0">
            <Grid>
                <TextBlock Text="PREVIEW" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top"/>
                <Canvas Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Line x:Name="LeftLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" X1="78" Y1="125" X2="112" Y2="125"/>
                    <Line x:Name="RightLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" X1="138" Y1="125" X2="172" Y2="125"/>
                    <Line x:Name="TopLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" X1="125" Y1="78" X2="125" Y2="112"/>
                    <Line x:Name="BottomLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" X1="125" Y1="138" X2="125" Y2="172"/>
                </Canvas>
                <TextBlock Text="Visual / Em desenvolvimento" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
