<UserControl x:Class="SecretFix.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Diagnóstico" Style="{StaticResource H1TextStyle}"/>
                <TextBlock Text="Leitura local do Windows, perfis reversíveis e medição observável de eventos de entrada." Style="{StaticResource CaptionTextStyle}" Margin="0,7,0,0"/>
            </StackPanel>
            <Button Content="ATUALIZAR" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Click="Refresh_Click"/>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="RecoveryCard" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14" Visibility="Collapsed">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="RECUPERAÇÃO PENDENTE" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/><TextBlock x:Name="RecoveryText" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="VERIFICAR ESTADO" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="RecoveryVerify_Click"/><Button Content="RESTAURAR BACKUP" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="RecoveryRestore_Click"/><Button Content="IGNORAR" Style="{StaticResource SecondaryButtonStyle}" Click="RecoveryIgnore_Click"/></StackPanel>
                    </Grid>
                </Border>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="MOUSE / HID" FontWeight="SemiBold"/><TextBlock x:Name="MouseDiagnosticText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="TECLADO / HID" FontWeight="SemiBold"/><TextBlock x:Name="KeyboardDiagnosticText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                </UniformGrid>
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="PERFIS DE OTIMIZAÇÃO" FontWeight="SemiBold"/><TextBlock x:Name="ProfilePlanText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="ProfileResultText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><ComboBox x:Name="ProfilePicker" SelectedIndex="0" SelectionChanged="ProfilePicker_SelectionChanged"><ComboBoxItem Tag="Balanced">BALANCED</ComboBoxItem><ComboBoxItem Tag="Competitive">COMPETITIVE</ComboBoxItem><ComboBoxItem Tag="Custom">CUSTOM</ComboBoxItem></ComboBox><Button Content="APLICAR MOUSE E TECLADO" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0" Click="ApplyProfile_Click"/><Button Content="RESTAURAR ÚLTIMOS BACKUPS" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" Click="Restore_Click"/></StackPanel>
                </Grid></Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14"><StackPanel><TextBlock Text="INPUT BENCHMARK" FontWeight="SemiBold"/><TextBlock Text="Estimativa baseada nos eventos Raw Input recebidos pelo Windows; não mede firmware USB nem latência total." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                    <UniformGrid Columns="4"><StackPanel><TextBlock Text="EVENTS" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="BenchmarkEvents" Text="—" FontSize="17"/></StackPanel><StackPanel><TextBlock Text="POLLING ESTIMADO" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="BenchmarkPolling" Text="—" FontSize="17"/></StackPanel><StackPanel><TextBlock Text="INTERVALO MÉDIO" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="BenchmarkAverage" Text="—" FontSize="17"/></StackPanel><StackPanel><TextBlock Text="JITTER / ESTABILIDADE" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="BenchmarkJitter" Text="—" FontSize="17"/></StackPanel></UniformGrid>
                    <TextBlock x:Name="BenchmarkRange" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
                    <Border Height="88" Background="#33141418" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,12,0,0">
                        <Canvas x:Name="BenchmarkGraph" ClipToBounds="True"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="INICIAR TESTE" Style="{StaticResource PrimaryButtonStyle}" Click="BenchmarkStart_Click"/><Button Content="PARAR" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="BenchmarkStop_Click"/><Button Content="RESETAR" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="BenchmarkReset_Click"/><Button Content="SALVAR COMO TESTE ANTES" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="SaveBefore_Click"/><Button Content="SALVAR COMO TESTE DEPOIS" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="SaveAfter_Click"/></StackPanel>
                    <TextBlock x:Name="BenchmarkCompareText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel></Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="16"><StackPanel><TextBlock Text="HISTÓRICO" FontWeight="SemiBold"/><ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/></StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
