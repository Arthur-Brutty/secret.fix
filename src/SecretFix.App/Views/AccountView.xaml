<UserControl x:Class="SecretFix.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Account" FontSize="32" FontWeight="Bold"/>
            <TextBlock Text="Licenca, plano, dispositivo e suporte" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,32,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="USUARIO" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    <TextBlock x:Name="UsernameText" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                    <Button Content="Upgrade Plan" Background="{StaticResource AccentBrush}" Foreground="White" Width="150" Height="42" HorizontalAlignment="Left" Margin="0,24,0,0"/>
                </StackPanel>
                <UniformGrid Grid.Column="1" Columns="2" Rows="4">
                    <StackPanel Margin="0,0,18,18"><TextBlock Text="License" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LicenseText" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Margin="0,0,18,18"><TextBlock Text="Plan" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PlanText" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Margin="0,0,18,18"><TextBlock Text="Expiration" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ExpirationText" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Margin="0,0,18,18"><TextBlock Text="Device" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DeviceText" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Margin="0,0,18,18"><TextBlock Text="App Version" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="VersionText" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Margin="0,0,18,18"><TextBlock Text="Device Bind" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DeviceBindText" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Margin="0,0,18,18"><TextBlock Text="Support ID" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SupportText" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Margin="0,0,18,18"><TextBlock Text="Last Login" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Local dev session" FontWeight="SemiBold"/></StackPanel>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
