<UserControl x:Class="SecretFix.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="32" FontWeight="Bold"/>
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Border Background="#151519" BorderBrush="#2D2D34" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,26,0,0">
                    <TextBlock x:Name="StateText" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
