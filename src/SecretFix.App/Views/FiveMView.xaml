<UserControl x:Class="SecretFix.Views.FiveMView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="FiveM" Style="{StaticResource H1TextStyle}"/>
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}" Padding="22" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="FiveM" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusText" Text="Verificando processo e instalação..." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                            <UniformGrid Columns="2" Margin="0,22,0,0">
                                <StackPanel Margin="0,0,20,12"><TextBlock Text="CAMINHO" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="PathText" Text="Não detectado" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Margin="0,0,20,12"><TextBlock Text="PROCESSO" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ProcessText" Text="Offline"/></StackPanel>
                                <StackPanel Margin="0,0,20,12"><TextBlock Text="INÍCIO" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="StartedText" Text="—"/></StackPanel>
                                <StackPanel Margin="0,0,20,12"><TextBlock Text="GTA V" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="Em desenvolvimento"/></StackPanel>
                                <StackPanel Margin="0,0,20,12"><TextBlock Text="STATUS" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="PlanText" Text="Disponível"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="PlayFiveMButton" Content="JOGAR FIVEM" Style="{StaticResource PrimaryButtonStyle}" Click="Play_Click"/>
                            <Button x:Name="PreparePlayButton" Content="PREPARAR E JOGAR" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" Click="PreparePlay_Click"/>
                            <Button x:Name="LocateButton" Content="LOCALIZAR FIVEM" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" Click="Locate_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,12,12"><StackPanel><TextBlock Text="PROCESS PRIORITY" FontWeight="SemiBold"/><TextBlock Text="Prioridade segura ainda não implementada." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><Button Content="EM DESENVOLVIMENTO" Style="{StaticResource SecondaryButtonStyle}" Margin="0,14,0,0" IsEnabled="False"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12"><StackPanel><TextBlock Text="AUTO BOOST" FontWeight="SemiBold"/><TextBlock Text="Automações reversíveis ainda não implementadas." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><Button Content="EM DESENVOLVIMENTO" Style="{StaticResource SecondaryButtonStyle}" Margin="0,14,0,0" IsEnabled="False"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,12,12"><StackPanel><TextBlock Text="CACHE" FontWeight="SemiBold"/><TextBlock Text="Limpeza segura será adicionada com backup." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><Button Content="EXPERIMENTAL · INDISPONÍVEL" Style="{StaticResource SecondaryButtonStyle}" Margin="0,14,0,0" IsEnabled="False"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12"><StackPanel><TextBlock Text="RESTORE" FontWeight="SemiBold"/><TextBlock Text="Acesse os snapshots locais do secret.fix." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><Button Content="ABRIR BACKUPS" Style="{StaticResource SecondaryButtonStyle}" Margin="0,14,0,0" Click="OpenBackups_Click"/></StackPanel></Border>
                </UniformGrid>
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="FIVEM INPUT ADVISOR" FontWeight="SemiBold"/>
                        <TextBlock Text="MANUAL / NOT AUTO-DETECTED — settings are never read from or injected into FiveM." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,8"><TextBlock Text="Mouse Input Method" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="InputMethodBox"/></StackPanel>
                            <StackPanel Margin="0,0,12,8"><TextBlock Text="Mouse Look Sensitivity" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="MouseLookBox"/></StackPanel>
                            <StackPanel Margin="0,0,12,8"><TextBlock Text="Driving Sensitivity" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="DrivingBox"/></StackPanel>
                            <StackPanel Margin="0,0,12,8"><TextBlock Text="Plane Sensitivity" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="PlaneBox"/></StackPanel>
                            <StackPanel Margin="0,0,12,8"><TextBlock Text="Helicopter Sensitivity" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="HelicopterBox"/></StackPanel>
                            <StackPanel Margin="0,0,12,8"><TextBlock Text="Mouse Smoothing Scale" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="SmoothingBox"/></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Fine Aiming Control / Submarine Sensitivity can be recorded in notes. These values are guidance only." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
                        <Button Content="SAVE MANUAL INPUT NOTES" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="SaveAdvisor_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
