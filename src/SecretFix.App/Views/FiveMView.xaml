<UserControl x:Class="SecretFix.Views.FiveMView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="FiveM" Style="{StaticResource H1TextStyle}"/>
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}" Padding="22" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="FiveM" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusText" Text="Verificando processo e instalação..." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                            <UniformGrid Columns="2" Margin="0,22,0,0">
                                <StackPanel Margin="0,0,20,12"><TextBlock Text="CAMINHO" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="PathText" Text="Não detectado" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Margin="0,0,20,12"><TextBlock Text="PROCESSO" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ProcessText" Text="Offline"/></StackPanel>
                                <StackPanel Margin="0,0,20,12"><TextBlock Text="GTA V" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="Em desenvolvimento"/></StackPanel>
                                <StackPanel Margin="0,0,20,12"><TextBlock Text="STATUS" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="PlanText" Text="Disponível"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                        <Button Grid.Column="1" Content="JOGAR FIVEM" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Click="Play_Click"/>
                    </Grid>
                </Border>
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,12,12"><StackPanel><TextBlock Text="PROCESS PRIORITY" FontWeight="SemiBold"/><TextBlock Text="Visual: prioridade segura quando processo for detectado." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><Button Content="EM DESENVOLVIMENTO" Style="{StaticResource SecondaryButtonStyle}" Margin="0,14,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12"><StackPanel><TextBlock Text="AUTO BOOST" FontWeight="SemiBold"/><TextBlock Text="Preparado para automações reversíveis, sem injeção." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><Button Content="PULSE+" Style="{StaticResource SecondaryButtonStyle}" Margin="0,14,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,12,12"><StackPanel><TextBlock Text="CACHE" FontWeight="SemiBold"/><TextBlock Text="Limpeza segura será adicionada com backup." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><Button Content="EXPERIMENTAL" Style="{StaticResource SecondaryButtonStyle}" Margin="0,14,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12"><StackPanel><TextBlock Text="RESTORE" FontWeight="SemiBold"/><TextBlock Text="Restauração depende de snapshots existentes." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><Button Content="ABRIR BACKUPS" Style="{StaticResource SecondaryButtonStyle}" Margin="0,14,0,0"/></StackPanel></Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
