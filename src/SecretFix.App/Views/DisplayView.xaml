<UserControl x:Class="SecretFix.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Display" Style="{StaticResource H1TextStyle}"/>
            <TextBlock Text="Presets visuais preparados para API segura futura" Style="{StaticResource CaptionTextStyle}" Margin="0,7,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="PRESETS" FontWeight="SemiBold"/>
                    <UniformGrid Columns="4" Margin="0,14,0,20">
                        <Button Content="NORMAL" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Preset_Click"/>
                        <Button Content="FPS" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Preset_Click"/>
                        <Button Content="VIBRANTE" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Preset_Click"/>
                        <Button Content="CUSTOM" Style="{StaticResource PrimaryButtonStyle}" Click="Preset_Click"/>
                    </UniformGrid>
                    <TextBlock x:Name="SatText" Text="Saturação: 50" Foreground="{StaticResource MutedBrush}"/><Slider x:Name="SatSlider" Style="{StaticResource ThinSliderStyle}" Minimum="0" Maximum="100" Value="50" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock x:Name="TempText" Text="Temperatura: 50" Foreground="{StaticResource MutedBrush}"/><Slider x:Name="TempSlider" Style="{StaticResource ThinSliderStyle}" Minimum="0" Maximum="100" Value="50" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock x:Name="GammaText" Text="Gamma: 50" Foreground="{StaticResource MutedBrush}"/><Slider x:Name="GammaSlider" Style="{StaticResource ThinSliderStyle}" Minimum="0" Maximum="100" Value="50" ValueChanged="Slider_ValueChanged"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18" Margin="20,0,0,0">
                <StackPanel>
                    <TextBlock Text="STATUS" FontWeight="SemiBold"/>
                    <TextBlock Text="Em desenvolvimento" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0"/>
                    <TextBlock Text="Nenhuma alteração real é aplicada sem API segura. Esta versão mantém apenas preview de valores e presets." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
