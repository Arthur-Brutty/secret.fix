<UserControl x:Class="SecretFix.Views.MouseFixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="Mouse" FontSize="32" FontWeight="Bold"/>
            <TextBlock Text="Configuracao avancada de precisao e resposta (Tracking/Flick)" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel x:Name="ToastHost" Grid.Column="2" HorizontalAlignment="Stretch" Visibility="Collapsed">
            <Border Background="#141418" BorderBrush="#5A1820" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock Text="OK" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock x:Name="ToastText" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,42,20,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="PERFORMANCE" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="18,18,18,8"/>
                <CheckBox x:Name="MousePrecision" Content="Mouse Precision" IsChecked="True" Margin="18,9"/>
                <CheckBox x:Name="PerformanceBoost" Content="Performance Boost" IsChecked="True" Margin="18,9"/>
                <CheckBox x:Name="Tracking" Content="Tracking" IsChecked="True" Margin="18,9"/>
                <CheckBox x:Name="Sensi" Content="Sensi X/Y" Margin="18,9"/>
                <CheckBox x:Name="Flick" Content="Flick" Margin="18,9"/>
                <CheckBox x:Name="HalfMs" Content="0.5MS visual flag" Margin="18,9"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,34">
            <Border Width="300" Height="450" Background="#151519" BorderBrush="#474750" BorderThickness="1" CornerRadius="128" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Border Width="8" Height="112" Background="#24242B" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,42,0,0"/>
                    <Border Width="34" Height="78" Background="#202026" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0"/>
                    <Border Width="150" Height="1" Background="#42424A" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,146,0,0"/>
                    <TextBlock Text="G" Foreground="{StaticResource AccentBrush}" FontSize="54" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,120,0,0"/>
                </Grid>
            </Border>
            <Border Width="250" Height="38" Background="#330B10" CornerRadius="125,125,0,0" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,42"/>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Margin="20,42,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="SISTEMA" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="18,18,18,8"/>
                <CheckBox Content="Registros mouse" Margin="18,9"/>
                <CheckBox Content="1SLC / RAM" Margin="18,9"/>
                <CheckBox Content="Flags" Margin="18,9"/>
                <CheckBox Content="Accessibility" IsChecked="True" Margin="18,9"/>
                <Separator Margin="18,14"/>
                <Button Content="Aplicar selecionados" Background="{StaticResource AccentBrush}" Foreground="White" Margin="18,0,18,10" Height="44" Click="Apply_Click"/>
                <Button Content="Restaurar sessao" Margin="18,0,18,10" Height="44" Click="RestoreSession_Click"/>
                <Button Content="Restaurar ultimo backup" Margin="18,0,18,14" Height="44" Click="RestoreLatest_Click"/>
                <TextBlock x:Name="StatusText" Text="Nenhuma alteracao aplicada." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="18,0,18,18"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
            <StackPanel>
                <TextBlock Text="SELECIONE SEU MOUSE" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                <UniformGrid Columns="6">
                    <Button x:Name="MouseLogitech" Tag="Logitech G Pro X Superlight 2" Click="Device_Click" Margin="0,0,12,0" Padding="12">
                        <StackPanel>
                            <Border Height="92" Background="#141418" CornerRadius="8" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                <TextBlock Text="G" Foreground="{StaticResource AccentBrush}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Logitech" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="G Pro X Superlight 2" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="Razer Viper V3 Pro" Click="Device_Click" Margin="0,0,12,0" Padding="12">
                        <StackPanel>
                            <Border Height="92" Background="#141418" CornerRadius="8"><TextBlock Text="R" Foreground="#7A7A82" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Razer" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Viper V3 Pro" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="Lamzu Atlantis OG V2 4K" Click="Device_Click" Margin="0,0,12,0" Padding="12">
                        <StackPanel>
                            <Border Height="92" Background="#F2F2F2" CornerRadius="8"><TextBlock Text="L" Foreground="#111" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Lamzu" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Atlantis OG V2 4K" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="Finalmouse UltralightX Lion" Click="Device_Click" Margin="0,0,12,0" Padding="12">
                        <StackPanel>
                            <Border Height="92" Background="#17171C" CornerRadius="8"><TextBlock Text="FM" Foreground="{StaticResource AccentBrush}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Finalmouse" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="UltralightX - Lion" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="ASUS ROG Harpe Ace" Click="Device_Click" Margin="0,0,12,0" Padding="12">
                        <StackPanel>
                            <Border Height="92" Background="#E9E9E9" CornerRadius="8"><TextBlock Text="ROG" Foreground="#18181E" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="ASUS ROG" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Harpe Ace" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="Zowie EC2-CW" Click="Device_Click" Padding="12">
                        <StackPanel>
                            <Border Height="92" Background="#121216" CornerRadius="8"><TextBlock Text="Z" Foreground="#A4A4AA" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Zowie" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="EC2-CW" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
