<UserControl x:Class="SecretFix.Views.MouseFixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="188"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Mouse" Style="{StaticResource H1TextStyle}"/>
                <TextBlock Text="Configuração avançada de precisão e resposta" Style="{StaticResource CaptionTextStyle}" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="APLICAR" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="Apply_Click"/>
                <Button Content="RESTAURAR" Style="{StaticResource SecondaryButtonStyle}" Click="RestoreLatest_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                <CheckBox x:Name="MousePrecision" Content="MOUSE PRECISION" Style="{StaticResource OptionToggleStyle}" IsChecked="True" Checked="Option_Checked"/>
                <CheckBox x:Name="PerformanceBoost" Content="PERFORMANCE BOOST" Style="{StaticResource OptionToggleStyle}" IsChecked="True" Checked="Option_Checked"/>
                <CheckBox x:Name="Tracking" Content="TRACKING" Style="{StaticResource OptionToggleStyle}" IsChecked="True" Checked="Option_Checked"/>
                <CheckBox x:Name="Sensi" Content="SENSI" Style="{StaticResource OptionToggleStyle}" Checked="Option_Checked"/>
                <CheckBox x:Name="Flick" Content="FLICK" Style="{StaticResource OptionToggleStyle}" Checked="Option_Checked"/>
                <CheckBox x:Name="HalfMs" Content="0.5MS" Style="{StaticResource OptionToggleStyle}" Checked="Option_Checked"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="HeroMouseImage"
                           Source="/Assets/Devices/Mice/hero-logitech-g.png"
                           Height="350"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="SelectedMouseText" Text="Logitech G Pro X Superlight 2" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Width="280" Height="34" Background="#661B060A" CornerRadius="140,140,0,0" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"/>
            </Grid>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                <CheckBox Content="REGISTROS MOUSE" Style="{StaticResource OptionToggleStyle}" Checked="Option_Checked"/>
                <CheckBox Content="ISLC / RAM" Style="{StaticResource OptionToggleStyle}" Checked="Option_Checked"/>
                <CheckBox Content="SENSI X/Y" Style="{StaticResource OptionToggleStyle}" IsChecked="True" Checked="Option_Checked"/>
                <CheckBox Content="FLAGS" Style="{StaticResource OptionToggleStyle}" Checked="Option_Checked"/>
                <CheckBox Content="ACCESSIBILITY" Style="{StaticResource OptionToggleStyle}" IsChecked="True" Checked="Option_Checked"/>
                <CheckBox Content="BOOST FIVEM" Style="{StaticResource OptionToggleStyle}" Checked="Option_Checked"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3" Height="18" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="SELECIONE SEU MOUSE" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="‹" Width="34" Height="34" Padding="0" Click="MousePrev_Click" Margin="0,0,8,0"/>
                        <Button Content="›" Width="34" Height="34" Padding="0" Click="MouseNext_Click"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="MouseScroll" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MouseLogitech" Style="{StaticResource DeviceButtonStyle}" Tag="/Assets/Devices/Mice/logitech-g-pro-x.png|Logitech|G Pro X Superlight 2" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Tag="/Assets/Devices/Mice/logitech-g-pro-x.png|Logitech|G Pro X Superlight" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Tag="/Assets/Devices/Mice/razer-viper-v3.png|Razer|Viper V3 Pro" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Tag="/Assets/Devices/Mice/razer-viper-v3.png|Razer|DeathAdder V3" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Tag="/Assets/Devices/Mice/asus-rog-harpe.png|Logitech|G502 X" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Tag="/Assets/Devices/Mice/finalmouse-ultralightx.png|Finalmouse|Starlight" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Tag="/Assets/Devices/Mice/zowie-ec2cw.png|Zowie|FK2" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Tag="/Assets/Devices/Mice/lamzu-atlantis.png|Lamzu|Atlantis" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Tag="/Assets/Devices/Mice/lamzu-atlantis.png|Pulsar|X2H" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Tag="/Assets/Devices/Mice/asus-rog-harpe.png|Attack Shark|X3" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Tag="/Assets/Devices/Mice/hero-logitech-g.png|secret.fix|Generic" Click="Device_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
