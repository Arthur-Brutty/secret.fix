<UserControl x:Class="SecretFix.Views.KeyboardFixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="188"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Teclado" Style="{StaticResource H1TextStyle}"/>
                <TextBlock Text="Configuração avançada de precisão e resposta" Style="{StaticResource CaptionTextStyle}" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="APLICAR" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="Apply_Click"/>
                <Button Content="RESTAURAR" Style="{StaticResource SecondaryButtonStyle}" Click="RestoreLatest_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="255"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                <CheckBox Content="PERFIL DE PRECISÃO" Style="{StaticResource OptionToggleStyle}" IsChecked="True" Checked="Option_Checked"/>
                <CheckBox Content="DELAY MÍNIMO" Style="{StaticResource OptionToggleStyle}" IsChecked="True" Checked="Option_Checked"/>
                <CheckBox Content="REPETIÇÃO MÁXIMA" Style="{StaticResource OptionToggleStyle}" IsChecked="True" Checked="Option_Checked"/>
                <CheckBox x:Name="FilterKeysOff" Content="FILTER KEYS OFF" Style="{StaticResource OptionToggleStyle}" IsChecked="True" Checked="Option_Checked"/>
                <CheckBox x:Name="StickyKeysOff" Content="STICKY KEYS OFF" Style="{StaticResource OptionToggleStyle}" IsChecked="True" Checked="Option_Checked"/>
                <CheckBox x:Name="ToggleKeysOff" Content="TOGGLE KEYS OFF" Style="{StaticResource OptionToggleStyle}" Checked="Option_Checked"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="HeroKeyboardImage"
                           Source="/Assets/Devices/Keyboards/hero-keyboard.png"
                           Height="260"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="SelectedKeyboardText" Text="Wooting 60HE" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                <CheckBox Content="REGISTRO TECLADO" Style="{StaticResource OptionToggleStyle}" IsChecked="True" Checked="Option_Checked"/>
                <CheckBox Content="MODO JOGO" Style="{StaticResource OptionToggleStyle}" IsChecked="True" Checked="Option_Checked"/>
                <CheckBox Content="ACCESSIBILITY" Style="{StaticResource OptionToggleStyle}" Checked="Option_Checked"/>
                <CheckBox Content="BOOST FIVEM" Style="{StaticResource OptionToggleStyle}" Checked="Option_Checked"/>
                <CheckBox Content="SERVIÇOS EM BACKGROUND" Style="{StaticResource OptionToggleStyle}" Checked="Option_Checked"/>
                <CheckBox Content="USB SELECTIVE SUSPEND" Style="{StaticResource OptionToggleStyle}" Checked="Option_Checked"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3" Height="18" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="SELECIONE SEU TECLADO" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="‹" Width="34" Height="34" Padding="0" Click="KeyboardPrev_Click" Margin="0,0,8,0"/>
                        <Button Content="›" Width="34" Height="34" Padding="0" Click="KeyboardNext_Click"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="KeyboardScroll" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="KeyboardWooting" Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/wooting-60he.png|Wooting|60HE" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/drunkdeer-a75.png|DrunkDeer|A75" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/hyperx-alloy-origins.png|HyperX|Alloy Origins" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/redragon-fizz.png|Redragon|Fizz" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/anne-pro-2.png|Anne Pro|2" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/keychron-k2.png|Keychron|K2" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/hyperx-alloy-origins.png|SteelSeries|Apex Pro" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/redragon-fizz.png|Razer|Huntsman Mini" Click="Device_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
