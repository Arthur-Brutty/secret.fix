<UserControl x:Class="SecretFix.Views.KeyboardFixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="188"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Teclado" Style="{StaticResource H1TextStyle}"/>
                <TextBlock Text="Configuração avançada de precisão e resposta" Style="{StaticResource CaptionTextStyle}" Margin="0,7,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock x:Name="DetectedKeyboardText" Text="Deteccao: aguardando..." Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <Button x:Name="DetectKeyboardButton" Content="DETECTAR NOVAMENTE" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="12,4" Margin="14,0,0,0" Click="DetectAgain_Click"/>
                    <ComboBox x:Name="ProfilePicker" Width="132" Height="30" Margin="10,0,0,0" SelectionChanged="ProfilePicker_SelectionChanged"><ComboBoxItem Tag="Balanced">BALANCED</ComboBoxItem><ComboBoxItem Tag="Competitive">COMPETITIVE</ComboBoxItem><ComboBoxItem Tag="Custom">CUSTOM</ComboBoxItem></ComboBox>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ApplyKeyboardButton" Content="APLICAR" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="Apply_Click"/>
                <Button x:Name="RestoreKeyboardButton" Content="RESTAURAR" Style="{StaticResource SecondaryButtonStyle}" Click="RestoreLatest_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="255"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                <CheckBox x:Name="PrecisionProfile" Content="PERFIL DE PRECISÃO" Style="{StaticResource OptionToggleStyle}" Click="Option_Click"/>
                <CheckBox x:Name="MinimumDelay" Content="DELAY MÍNIMO" Style="{StaticResource OptionToggleStyle}" Click="Option_Click"/>
                <CheckBox x:Name="MaximumRepeat" Content="REPETIÇÃO MÁXIMA" Style="{StaticResource OptionToggleStyle}" Click="Option_Click"/>
                <CheckBox x:Name="FilterKeysOff" Content="FILTER KEYS OFF" Style="{StaticResource OptionToggleStyle}" Click="Option_Click"/>
                <CheckBox x:Name="StickyKeysOff" Content="STICKY KEYS OFF" Style="{StaticResource OptionToggleStyle}" Click="Option_Click"/>
                <CheckBox x:Name="ToggleKeysOff" Content="TOGGLE KEYS OFF" Style="{StaticResource OptionToggleStyle}" Click="Option_Click"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="HeroKeyboardImage"
                           Source="/Assets/Devices/Keyboards/generic-keyboard.png"
                           Height="260"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="SelectedKeyboardText" Text="Wooting 60HE" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock x:Name="OperationText" Text="NÃO APLICADO · selecione um perfil para ver e aplicar alterações verificáveis." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="390" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                <CheckBox x:Name="RegistryVisual" Content="REGISTRO TECLADO" Style="{StaticResource OptionToggleStyle}" Click="Option_Click"/>
                <CheckBox x:Name="GameModeVisual" Content="MODO JOGO" Style="{StaticResource OptionToggleStyle}" Click="Option_Click"/>
                <CheckBox x:Name="AccessibilityVisual" Content="ACCESSIBILITY" Style="{StaticResource OptionToggleStyle}" Click="Option_Click"/>
                <CheckBox x:Name="FiveMBoostVisual" Content="BOOST FIVEM" Style="{StaticResource OptionToggleStyle}" Click="Option_Click"/>
                <CheckBox x:Name="BackgroundServicesVisual" Content="SERVIÇOS EM BACKGROUND" Style="{StaticResource OptionToggleStyle}" Click="Option_Click"/>
                <CheckBox x:Name="UsbSelectiveSuspendVisual" Content="USB SELECTIVE SUSPEND" Style="{StaticResource OptionToggleStyle}" Click="Option_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3" Height="18" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="SELECIONE SEU TECLADO" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="‹" Width="34" Height="34" Padding="0" Click="KeyboardPrev_Click" Margin="0,0,8,0"/>
                        <Button Content="›" Width="34" Height="34" Padding="0" Click="KeyboardNext_Click"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="KeyboardScroll" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="KeyboardWooting" Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/wooting-60he.png|Wooting|60HE" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/drunkdeer-a75.png|DrunkDeer|A75" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/hyperx-alloy-origins.png|HyperX|Alloy Origins" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/redragon-fizz.png|Redragon|Fizz" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/anne-pro-2.png|Anne Pro|2" Click="Device_Click"/>
                        <Button Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/keychron-k2.png|Keychron|K2" Click="Device_Click"/>
                        <Button x:Name="KeyboardGeneric" Style="{StaticResource DeviceButtonStyle}" Width="176" Tag="/Assets/Devices/Keyboards/generic-keyboard.png|secret.fix|Generic Keyboard" Click="Device_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
