<Window x:Class="SecretFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="secret.fix" Width="1440" Height="860"
        MinWidth="1180" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0C0C10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <Image Source="Assets/Branding/secret-fix-logo.png" Width="170" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="VersionText" Text="v0.5.0 dev" Foreground="{StaticResource MutedBrush}" Margin="4,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,24,0,14">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="PROGRESSO DA OTIMIZACAO" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock Text="25%" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ProgressBar Value="25" Height="7" Margin="0,12,0,10" Foreground="{StaticResource AccentBrush}" Background="#2C2023"/>
                        <TextBlock Text="Aplicando otimizacoes de sistema..." Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2">
                    <Button x:Name="MouseButton" Style="{StaticResource NavButtonStyle}" Tag="Mouse" Click="Nav_Click" Content="MouseFix"/>
                    <Button x:Name="KeyboardButton" Style="{StaticResource NavButtonStyle}" Tag="Keyboard" Click="Nav_Click" Content="TecladoFix"/>
                    <Button x:Name="FiveMButton" Style="{StaticResource NavButtonStyle}" Tag="FiveM" Click="Nav_Click" Content="FiveM"/>
                    <Button x:Name="FlickButton" Style="{StaticResource NavButtonStyle}" Tag="Flick" Click="Nav_Click" Content="Flick"/>
                    <Button x:Name="SensiButton" Style="{StaticResource NavButtonStyle}" Tag="Sensi" Click="Nav_Click" Content="Sensi"/>
                    <Button x:Name="AimButton" Style="{StaticResource NavButtonStyle}" Tag="Aim" Click="Nav_Click" Content="Mira"/>
                    <Button x:Name="ServicesButton" Style="{StaticResource NavButtonStyle}" Tag="Services" Click="Nav_Click" Content="Servicos"/>
                    <Button x:Name="DisplayButton" Style="{StaticResource NavButtonStyle}" Tag="Display" Click="Nav_Click" Content="Display"/>
                    <Button x:Name="AccountButton" Style="{StaticResource NavButtonStyle}" Tag="Account" Click="Nav_Click" Content="Account"/>
                </StackPanel>

                <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#1E1E24" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <TextBlock Text="SF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="UserText" Text="Carregando..." FontWeight="SemiBold"/>
                            <TextBlock x:Name="PlanText" Text="LICENSE" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="34"/>
    </Grid>
</Window>
