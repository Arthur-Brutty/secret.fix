<Window x:Class="SecretFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="secret.fix" Width="1280" Height="800"
        MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0C0C10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="secret.fix" FontSize="32" FontWeight="Bold"/>
                    <TextBlock Text="v0.5.0 dev" Foreground="{StaticResource MutedBrush}" Margin="2,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <Button Content="MouseFix" Tag="Mouse" Click="Nav_Click" Margin="0,4" Height="44"/>
                    <Button Content="TecladoFix" Tag="Keyboard" Click="Nav_Click" Margin="0,4" Height="44"/>
                    <Button Content="FiveM" Tag="FiveM" Click="Nav_Click" Margin="0,4" Height="44"/>
                    <Button Content="Flick" Tag="Flick" Click="Nav_Click" Margin="0,4" Height="44"/>
                    <Button Content="Sensi" Tag="Sensi" Click="Nav_Click" Margin="0,4" Height="44"/>
                    <Button Content="Mira" Tag="Aim" Click="Nav_Click" Margin="0,4" Height="44"/>
                    <Button Content="Serviços" Tag="Services" Click="Nav_Click" Margin="0,4" Height="44"/>
                    <Button Content="Display" Tag="Display" Click="Nav_Click" Margin="0,4" Height="44"/>
                    <Button Content="Account" Tag="Account" Click="Nav_Click" Margin="0,4" Height="44"/>
                </StackPanel>
                <Border Grid.Row="3" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock Text="SecretUser" FontWeight="SemiBold"/>
                        <TextBlock Text="APEX • ACTIVE" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="PageTitle" Text="MouseFix" FontSize="30" FontWeight="Bold"/>
                <TextBlock x:Name="PageSubtitle" Text="Precisão e resposta do mouse" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <TextBlock Text="PERFORMANCE &amp; PRECISION" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,12"/>
                        <CheckBox Content="Mouse Precision" x:Name="MousePrecision" Margin="0,10" IsChecked="True"/>
                        <CheckBox Content="Performance Boost" Margin="0,10"/>
                        <CheckBox Content="Tracking" Margin="0,10"/>
                        <CheckBox Content="Sensi" Margin="0,10"/>
                        <CheckBox Content="Flick" Margin="0,10"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="18,0" CornerRadius="14" Background="#0B0B0F" BorderBrush="#301016" BorderThickness="1">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="230" Height="330" CornerRadius="110" Background="#15151A" BorderBrush="#4A1A20" BorderThickness="1">
                                <TextBlock Text="MOUSE" Foreground="{StaticResource AccentBrush}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Selecione seu mouse" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,0"/>
                            <TextBlock Text="Cards e imagens finais entram na próxima iteração" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" CornerRadius="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <TextBlock Text="AÇÕES" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Button Content="Aplicar selecionados" Height="46" Background="{StaticResource AccentBrush}" Foreground="White" Click="Apply_Click"/>
                        <Button Content="Restaurar sessão" Height="46" Margin="0,10,0,0" Click="Restore_Click"/>
                        <Separator Margin="0,20"/>
                        <TextBlock x:Name="StatusText" Text="Nenhuma alteração aplicada nesta sessão." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
