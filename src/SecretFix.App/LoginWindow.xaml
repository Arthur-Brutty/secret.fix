<Window x:Class="SecretFix.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="secret.fix login"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <MediaElement x:Name="GalaxyBackground" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="UniformToFill" IsHitTestVisible="False" MediaEnded="GalaxyBackground_MediaEnded" MediaFailed="GalaxyBackground_MediaFailed"/>
            <Rectangle Fill="{StaticResource OverlayBrush}" IsHitTestVisible="False"/>

            <Grid MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Button Style="{StaticResource WindowButtonStyle}" Content="X" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" Click="Close_Click"/>

                <Border Style="{StaticResource CardBorderStyle}" Width="360" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="secret.fix" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="v0.4 test build" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,26"/>

                        <TextBlock Text="USERNAME" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="UsernameBox" Height="38" Margin="0,8,0,16"/>

                        <TextBlock Text="LICENSE KEY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="LicenseBox" Height="38" Margin="0,8,0,18"/>

                        <Button Content="ENTRAR" Style="{StaticResource PrimaryButtonStyle}" Click="SignIn_Click"/>
                        <TextBlock x:Name="StatusText" Text="Local-only development mock. No production authentication backend is included." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
